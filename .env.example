NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Enable mock data only when all Statistics endpoints are unavailable.
NEXT_PUBLIC_STATS_USE_MOCK_FALLBACK=false

# Limit how many goals are used to load progress logs for Statistics chart.
NEXT_PUBLIC_STATS_PROGRESS_GOALS_LIMIT=10

# Progress log page size per goal when building monthly chart data.
NEXT_PUBLIC_STATS_PROGRESS_LOGS_LIMIT=60
